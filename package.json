{
  "name": "chdss",
  "version": "2.1.0",
  "description": "Christian's Handy Dandy Screen Share — low-latency LAN screen and audio sharing",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "chdss": "bin/chdss.js"
  },
  "scripts": {
    "prestart": "npm run build:web && node scripts/build-native.js",
    "start": "electron .",
    "build:web": "node scripts/build-web.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "test:install": "node --test test/install.test.js",
    "predist:win": "npm run build:web && node scripts/build-native.js --platform win32 --arch x64",
    "dist:win": "electron-builder --win portable --x64",
    "predist:mac": "npm run build:web && node scripts/build-native.js --platform darwin --arch arm64",
    "dist:mac": "electron-builder --mac dir --arm64",
    "dist:server": "npm run build:web && node scripts/package-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "livekit-client": "^2.22.2",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.christiankossmann.chdss",
    "productName": "CHDSS",
    "asar": true,
    "artifactName": "CHDSS-${version}-Windows-Portable.${ext}",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "extraResources": [{ "from": "native/bin/win32-x64", "to": "native", "filter": ["chdss-audio.exe"] }],
      "target": "portable"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "extraResources": [{ "from": "native/bin/darwin-arm64", "to": "native", "filter": ["chdss-audio"] }],
      "target": "dir",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "CHDSS shares system audio with your invited viewers, on your LAN or through your chosen server.",
        "NSScreenCaptureUsageDescription": "CHDSS shares only the screen or window you select with your invited viewers."
      }
    }
  },
  "author": "Christian Kossmann",
  "license": "MIT"
}
